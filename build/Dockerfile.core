FROM base-gomod AS builder

WORKDIR /app

COPY core .

RUN CGO_ENABLED=1 go build -ldflags "-s -w" -o hwlite "./cmd/homework"

FROM gcr.io/distroless/base-debian13:nonroot

WORKDIR /app

COPY --from=builder /app/hwlite /usr/bin/hwlite

COPY --from=base-frontend /build/build/web web

COPY build/entrypoint.sh entrypoint.sh

ENV HW_DOWNLOAD_DIR=/downloads
ENV HW_BROWSER_DIR=/browser
ENV HW_ASSET_DIR=/assets
ENV HW_DATABASE_DIR=/appdata
ENV HW_UPLOAD_DIR=/uploads

EXPOSE 9911

ENTRYPOINT ["hwlite"]
